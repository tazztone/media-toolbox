#!/usr/bin/env bash
set -eo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# 1. Shell script syntax check
SHELL_FILES=$(find src tests -type f -name "*.sh" 2>/dev/null || true)
for sh_file in $SHELL_FILES; do
    [ -f "$sh_file" ] || continue
    if ! bash -n "$sh_file"; then
        echo "❌ Bash syntax error in $sh_file"
        exit 1
    fi
done

# 2. Run unit tests via local venv
PYTEST_BIN="$REPO_ROOT/.venv/bin/pytest"
TEST_MARKER="${PRE_COMMIT_TEST_MARKER:-not integration and not desktop}"
if [ -x "$PYTEST_BIN" ]; then
    "$PYTEST_BIN" -m "$TEST_MARKER" tests/
else
    if command -v pytest &>/dev/null; then
        pytest -m "$TEST_MARKER" tests/
    else
        echo "⚠️  pytest not found in .venv/bin or PATH; skipping test runner."
    fi
fi

# 3. Warn on oversized files (production source > 30 KB, test suites > 50 KB)
LARGE_SRC=$(find src -name "*.py" -not -path "*/__pycache__/*" -size +30k 2>/dev/null || true)
LARGE_TESTS=$(find tests -name "*.py" -not -path "*/__pycache__/*" -size +50k 2>/dev/null || true)
if [ -n "$LARGE_SRC" ] || [ -n "$LARGE_TESTS" ]; then
    echo "⚠️  Oversized files (src > 30 KB, tests > 50 KB):"
    for f in $LARGE_SRC $LARGE_TESTS; do
        [ -f "$f" ] || continue
        printf '   %6s  %s\n' "$(du -h "$f" | cut -f1)" "$f"
    done
fi

exit 0
